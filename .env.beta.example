# Safe Intelligence beta — copy to .env.beta and fill in the NEW project.
# .env.beta is gitignored. Do not put the live project's URL or key here.
#
# Build with: npm run build:beta
# That uses Vite mode "beta", so this file overrides .env / .env.local and
# .env.production (the live app) is not loaded.
#
# The browser client accepts the new publishable key (sb_publishable_...).
# A legacy anon JWT is not required.

# New beta project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Publishable key from the beta project. Either name works.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Beta AI proxy. Deploy supabase/functions/generate-grok (not quick-worker).
# quick-worker stays the Anthropic proxy and returns 402 when the trial ends.
# e.g. https://abcdefgh.supabase.co/functions/v1/generate-grok
VITE_AI_PROXY_URL=
